{
  "name": "teaching-app",
  "version": "1.0.0",
  "description": "Automated Multi-Agent Lecture Development System",
  "main": "dist/index.js",
  "bin": {
    "lecture-dev": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "server": "tsx src/server/server.ts",
    "server:dev": "nodemon --exec tsx src/server/server.ts",
    "client": "cd client && npm start",
    "client:build": "cd client && npm run build",
    "dev:full": "concurrently \"npm run server:dev\" \"npm run client\"",
    "clean": "rm -rf dist output client/build sessions logs coverage",
    "test": "USE_MOCK_AI=true tsx src/tests/test-suite.ts",
    "test:jest": "USE_MOCK_AI=true jest",
    "test:jest:watch": "USE_MOCK_AI=true jest --watch",
    "test:jest:coverage": "USE_MOCK_AI=true jest --coverage",
    "test:client": "cd client && npm test",
    "test:client:coverage": "cd client && npm test -- --coverage --watchAll=false",
    "test:all": "npm run test:jest && npm run test:client:coverage",
    "test:server": "USE_MOCK_AI=true npm run server",
    "test:full": "USE_MOCK_AI=true concurrently \"npm run server\" \"sleep 3 && npm test\""
  },
  "keywords": [
    "education",
    "ai",
    "agents",
    "lecture",
    "teaching"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.1",
    "@types/archiver": "^7.0.0",
    "@types/formidable": "^3.4.6",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^24.10.1",
    "@types/pdf-parse": "^1.1.5",
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "body-parser": "^2.2.0",
    "chalk": "^5.6.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "formidable": "^3.5.4",
    "helmet": "^8.1.0",
    "inquirer": "^13.0.1",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "openai": "^6.9.1",
    "pdf-parse": "^2.4.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "jest": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "nodemon": "^3.1.11",
    "nyc": "^17.1.0",
    "playwright": "^1.56.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6"
  }
}
